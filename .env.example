# El equipo NO necesita ningún archivo .env: la web funciona con datos de ejemplo.
# Este archivo solo documenta las variables que usa GitHub al publicar la web.
# El archivo .env nunca se sube al repositorio.

# true (o sin definir) = datos de ejemplo guardados en el navegador.
# false               = Firebase. En local (pnpm dev) la web NUNCA se conecta al proyecto real:
#                       busca los emuladores de Firebase (ver docs/ENTORNOS.md).
VITE_USE_MOCKS=true

# Solo para construir la web de producción (lo hace GitHub al desplegar, no tú).
# Configuración de la app web de Firebase (consola de Firebase → Configuración del proyecto).
# No son contraseñas: identifican el proyecto. Lo que protege los datos son las reglas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
